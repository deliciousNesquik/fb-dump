# fb-dump reads its connection settings from flags or from these variables.
# Load this file with your shell (`set -a; . ./.env; set +a`), with direnv, or
# with `uv run --env-file .env fb-dump ...`. fb-dump itself does not read .env.

# Standard Firebird client variables — fbclient honours them directly.
ISC_USER=SYSDBA
ISC_PASSWORD=masterkey

# Database: alias, path, or HOST:ALIAS_OR_PATH (same as --database).
FB_DATABASE=localhost:employee

# SQL role to connect with (same as --role).
# FB_ROLE=SOME_ROLE

# Connection character set (same as --charset). Default UTF8; legacy Cyrillic
# databases usually need WIN1251.
# FB_CHARSET=WIN1251
